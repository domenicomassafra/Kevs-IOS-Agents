FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json tsconfig.web.json drizzle.config.ts ./
COPY drizzle ./drizzle
COPY src ./src
COPY static ./static
COPY Patches ./Patches
COPY integrations ./integrations

ENV NODE_ENV=production \
    PHONE_FARM_ROLE=control-plane \
    WEB_HOST=127.0.0.1 \
    WEB_PORT=3000 \
    DEVICES_CONFIG_PATH=/data/devices.json \
    SCHEDULER_DATA_DIR=/data/scheduler

CMD ["sh", "-c", "npm run db:migrate && npm run web"]
