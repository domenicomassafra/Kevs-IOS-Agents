FROM node:22-bookworm-slim AS verified

WORKDIR /app

COPY package.json package-lock.json ./
# The control plane never executes the native OCR/iPhone automation stack.
# node-native-ocr's Linux prebuild currently requires a newer glibc than the
# stable Bookworm base, so do not execute dependency install scripts here.
# Platform-specific optional packages (for example esbuild/tsx) are still
# installed by npm and are smoke-tested after the source is copied below.
RUN npm ci --ignore-scripts

COPY tsconfig.json tsconfig.web.json drizzle.config.ts ./
COPY drizzle ./drizzle
COPY src ./src
COPY static ./static
COPY Patches ./Patches
COPY integrations ./integrations
COPY test ./test

RUN npm run check \
    && npm run build:web \
    && node --import tsx -e "import('./src/api/server.ts').then(() => console.log('control-plane import OK'))"

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

COPY package.json package-lock.json ./
# Production needs tsx to execute the checked TypeScript source, but not the
# Appium/tooling/typecheck dev dependency set used by the verification stage.
RUN npm ci --omit=dev --ignore-scripts
COPY --from=verified /app/tsconfig.json /app/tsconfig.web.json /app/drizzle.config.ts ./
COPY --from=verified /app/drizzle ./drizzle
COPY --from=verified /app/src ./src
COPY --from=verified /app/static ./static
COPY --from=verified /app/Patches ./Patches
COPY --from=verified /app/integrations ./integrations

ENV NODE_ENV=production \
    PHONE_FARM_ROLE=control-plane \
    WEB_HOST=127.0.0.1 \
    WEB_PORT=3000 \
    DEVICES_CONFIG_PATH=/data/devices.json \
    SCHEDULER_DATA_DIR=/data/scheduler

CMD ["sh", "-c", "npm run db:migrate && exec node --env-file-if-exists=.env --env-file-if-exists=.env.devices --import tsx src/api/server.ts"]
